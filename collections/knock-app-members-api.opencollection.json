{
  "opencollection": "1.0.0",
  "info": {
    "name": "Knock Audiences Accounts Members API",
    "version": "1.0"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Members",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Get a member",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.knock.app/v1/members/:id",
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path",
                "description": "The ID of the member to retrieve."
              }
            ]
          },
          "docs": "Returns a single member by their ID."
        },
        {
          "info": {
            "name": "Remove a member",
            "type": "http"
          },
          "http": {
            "method": "DELETE",
            "url": "https://api.knock.app/v1/members/:id",
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path",
                "description": "The ID of the member to remove."
              }
            ]
          },
          "docs": "Removes a member from the account."
        },
        {
          "info": {
            "name": "List members",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.knock.app/v1/members",
            "params": [
              {
                "name": "role",
                "value": "",
                "type": "query",
                "description": "Filter members by role. One of: owner, admin, member, production_only_member, billing, support."
              },
              {
                "name": "email",
                "value": "",
                "type": "query",
                "description": "Filter members by email address (exact match)."
              },
              {
                "name": "after",
                "value": "",
                "type": "query",
                "description": "The cursor to fetch entries after."
              },
              {
                "name": "before",
                "value": "",
                "type": "query",
                "description": "The cursor to fetch entries before."
              },
              {
                "name": "limit",
                "value": "",
                "type": "query",
                "description": "The number of entries to fetch per-page."
              }
            ]
          },
          "docs": "Returns a paginated list of members for the current account. Optionally filter by role."
        }
      ]
    }
  ],
  "bundled": true
}