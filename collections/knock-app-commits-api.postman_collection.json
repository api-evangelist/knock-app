        {
          "id": "61d53247-8814-44d6-8a30-1fcd5113785a",
          "name": "Promote all changes",
          "request": {
            "name": "Promote all changes",
            "description": {
              "content": "Promote all changes across all resources to the target environment from its preceding environment.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "v1",
                "commits",
                "promote"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "to_environment",
                  "value": "<string>",
                  "description": "(Required) A slug of the target environment to which you want to promote all changes from its directly preceding environment.\n\nFor example, if you have three environments “development”, “staging”, and “production” (in that order), setting this param to “production” will promote all commits not currently in production from staging.\n\nWhen this param is set to `\"development\"`, the `\"branch\"` param must be provided.\n"
                },
                {
                  "disabled": false,
                  "key": "branch",
                  "value": "<string>",
                  "description": "The slug of the branch to promote all changes from."
                },
                {
                  "disabled": false,
                  "key": "resource_type",
                  "value": "<string>",
                  "description": "Filter commits to promote by resource type(s). Accepts a single type or array of types. Can be combined with resource_id to filter for specific resources."
                },
                {
                  "disabled": false,
                  "key": "resource_id",
                  "value": "<string>",
                  "description": "Filter commits to promote by resource identifier. Must be used together with resource_type."
                }
              ],
              "variable": []
