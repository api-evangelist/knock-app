{
  "opencollection": "1.0.0",
  "info": {
    "name": "Knock Audiences Accounts API",
    "version": "1.0"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Accounts",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Verify scope",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.knock.app/v1/whoami"
          },
          "docs": "Return information about the current calling scope. Will either be a service token or from an OAuth context."
        }
      ]
    }
  ],
  "bundled": true
}